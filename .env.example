# Supabase → Project Settings → API
# Copy this file to .env.local and fill in your project values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the legacy "anon" "public" JWT (starts with eyJ) for email/password auth.
# Publishable keys (sb_publishable_…) often break sign-in/sign-up until Supabase finishes key rollout.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Supabase Dashboard → Authentication → URL configuration:
# Add http://localhost:3000/auth/callback (and your production URL + /auth/callback)
